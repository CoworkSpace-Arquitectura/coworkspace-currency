# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# Base de datos PostgreSQL del servicio (en producción: Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coworkspace_currency

# Puerto HTTP
PORT=3009

# Bus de eventos (en producción: Upstash Redis)
REDIS_URL=redis://localhost:6379

# Proveedor de tasas de cambio
RATES_API_URL=https://open.er-api.com/v6/latest
